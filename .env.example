DISCORD_BOT_TOKEN=
# Optional: sync slash commands instantly to one server while developing.
DISCORD_GUILD_ID=

# openai or local
STT_PROVIDER=openai
# OpenAI default: gpt-4o-mini-transcribe; local default: small
STT_MODEL=
# Optional ISO-639-1 code such as en
STT_LANGUAGE=

# Required only when STT_PROVIDER=openai
OPENAI_API_KEY=
