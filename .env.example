DISCORD_BOT_TOKEN=
# Optional: sync slash commands instantly to one server while developing.
DISCORD_GUILD_ID=

# auto (default), openai, or local.
# "auto" mirrors Hermes Agent: local backend first, then OpenAI.
STT_PROVIDER=auto
# Leave blank to use the same defaults as Hermes Agent:
#   openai -> whisper-1   (Hermes stt.openai.model)
#   local  -> base        (Hermes stt.local.model, faster-whisper)
STT_MODEL=
# Optional ISO-639-1 code such as en
STT_LANGUAGE=

# Required when the resolved provider is openai
OPENAI_API_KEY=
